{
  "//": "The rules of a folder path, read by src/test/folders.test.ts and src-tauri/src/folder_path.rs so the frontend and the backend cannot drift. `input` is the raw text, or `repeat` builds it. Exactly one outcome is expected: `path` (the stored form), `same` (stored as typed), `unset` (a blank path: no folder) or `error` (the message shown).",
  "cases": [
    { "input": "prod/eu", "path": "prod/eu" },
    { "input": "prod", "path": "prod" },
    { "input": "", "unset": true },
    { "input": "   ", "unset": true },
    { "input": "/", "unset": true },
    { "input": "///", "unset": true },
    { "input": " / / ", "unset": true },
    { "input": "\\", "unset": true },
    { "input": "/prod/", "path": "prod" },
    { "input": "//prod//eu//", "path": "prod/eu" },
    { "input": " prod / eu//west ", "path": "prod/eu/west" },
    { "input": "prod\\eu", "path": "prod/eu" },
    { "input": "prod\\/eu", "path": "prod/eu" },
    { "input": "Prod/EU", "path": "Prod/EU" },
    { "input": "my servers/eu west", "path": "my servers/eu west" },
    { "input": "my  servers", "path": "my  servers" },
    { "input": " prod ", "path": "prod" },
    { "input": "　prod / eu ", "path": "prod/eu" },
    { "input": "﻿prod﻿", "path": "﻿prod﻿" },
    { "input": "pr​od", "path": "pr​od" },
    { "input": "...", "path": "..." },
    { "input": "..prod", "path": "..prod" },
    { "input": "prod..", "path": "prod.." },
    { "input": "a.b/c..d", "path": "a.b/c..d" },
    { "input": "__proto__/constructor", "path": "__proto__/constructor" },
    { "input": "serveurs/préprod/🚀", "path": "serveurs/préprod/🚀" },
    { "input": ".", "error": "A folder cannot be named . or .." },
    { "input": "..", "error": "A folder cannot be named . or .." },
    { "input": "prod/..", "error": "A folder cannot be named . or .." },
    { "input": "../prod", "error": "A folder cannot be named . or .." },
    { "input": "prod/../eu", "error": "A folder cannot be named . or .." },
    { "input": "prod/ .. /eu", "error": "A folder cannot be named . or .." },
    { "input": "prod\\..\\eu", "error": "A folder cannot be named . or .." },
    { "input": "./prod", "error": "A folder cannot be named . or .." },
    { "input": "prod\neu", "error": "A folder path cannot contain control characters" },
    { "input": "prod\n", "error": "A folder path cannot contain control characters" },
    { "input": "\tprod", "error": "A folder path cannot contain control characters" },
    { "input": "pr\u0000od", "error": "A folder path cannot contain control characters" },
    { "input": "pr\u0007od", "error": "A folder path cannot contain control characters" },
    { "input": "pr\u007fod", "error": "A folder path cannot contain control characters" },
    { "input": "pr\u0085od", "error": "A folder path cannot contain control characters" },
    { "input": "pr\u009fod", "error": "A folder path cannot contain control characters" },
    { "input": "a/b/c/d/e/f/g/h/i/j", "path": "a/b/c/d/e/f/g/h/i/j" },
    { "input": "a/b/c/d/e/f/g/h/i/j/k", "error": "Folders can nest at most 10 levels" },
    { "repeat": { "text": "x", "times": 512 }, "same": true },
    { "repeat": { "text": "x", "times": 513 }, "error": "A folder path can be at most 512 characters" },
    { "repeat": { "text": "🚀", "times": 512 }, "same": true },
    { "repeat": { "text": "🚀", "times": 513 }, "error": "A folder path can be at most 512 characters" },
    { "repeat": { "text": " ", "times": 2000 }, "unset": true },
    { "repeat": { "text": "/", "times": 2000 }, "unset": true }
  ],
  "renames": [
    { "from": "prod", "to": "staging" },
    { "from": "prod/eu", "to": "eu" },
    { "from": "prod", "to": "production" },
    { "from": "prod", "to": "Prod" },
    { "from": "prod", "to": "prod" },
    { "from": "prod/eu", "to": "prod" },
    { "from": "prod", "to": "  /staging/ " },
    { "from": "prod", "to": "prod/eu", "error": "A folder cannot move inside itself" },
    { "from": "prod", "to": "prod/eu/west", "error": "A folder cannot move inside itself" },
    { "from": "prod", "to": "", "error": "A folder path is required" },
    { "from": "prod", "to": " / ", "error": "A folder path is required" },
    { "from": "prod", "to": "a/../b", "error": "A folder cannot be named . or .." }
  ]
}
